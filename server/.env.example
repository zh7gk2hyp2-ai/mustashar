# ════════════════════════════════════════
# منصة مستشار – متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم
# ════════════════════════════════════════

# الخادم
PORT=3000
NODE_ENV=production

# ── قاعدة البيانات (MySQL) ──────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mustashar_db
DB_USER=mustashar_user
DB_PASS=CHANGE_THIS_STRONG_PASSWORD
DB_CHARSET=utf8mb4

# ── JWT ────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES=8h

# ── الحساب الإداري الافتراضي ────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
ADMIN_EMAIL=research@tu.edu.sa

# ── LDAP / Active Directory جامعة الطائف ──
LDAP_ENABLED=false
LDAP_URL=ldap://ad.tu.edu.sa:389
LDAP_BASE_DN=DC=tu,DC=edu,DC=sa
LDAP_BIND_DN=CN=svc-mustashar,OU=ServiceAccounts,DC=tu,DC=edu,DC=sa
LDAP_BIND_PASS=CHANGE_THIS

# ── Banner Integration (Ellucian) ───────
BANNER_ENABLED=false
BANNER_API_URL=https://banner.tu.edu.sa/api
BANNER_API_KEY=CHANGE_THIS

# ── رفع الملفات ─────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── البريد الإلكتروني ───────────────────
SMTP_HOST=smtp.tu.edu.sa
SMTP_PORT=587
SMTP_USER=noreply@tu.edu.sa
SMTP_PASS=CHANGE_THIS
SMTP_FROM="منصة مستشار <noreply@tu.edu.sa>"

# ── CORS ────────────────────────────────
ALLOWED_ORIGINS=https://mustashar.tu.edu.sa,https://research.tu.edu.sa
